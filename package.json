{
  "name": "djshard",
  "version": "0.1.0",
  "description": "Clustered + cross-host sharding for Discord bots on Bun, with a Kubernetes operator",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun check",
    "test": "bun test",
    "ci": "bun run lint && bun run fmt:check && bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.78.0",
    "oxlint": "^1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "bun": ">=1.2"
  }
}
